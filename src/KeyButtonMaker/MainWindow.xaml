<Window x:Class="KeyButtonMaker.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:KeyButtonMaker"
		Title="KeyButtonMaker"
		Icon="/app.ico"
		Width="980"
		Height="580"
		MinWidth="760"
		MinHeight="420"
		WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Padding" Value="6,3" />
		</Style>
		<!--  キー入力をキャプチャするテキストボックス(DataContext は KeyCombo)  -->
		<Style x:Key="KeyCaptureBox"
			   TargetType="TextBox">
			<Setter Property="IsReadOnly" Value="True" />
			<Setter Property="IsReadOnlyCaretVisible" Value="False" />
			<Setter Property="Padding" Value="3" />
			<Setter Property="Text" Value="{Binding Text, Mode=OneWay}" />
			<Setter Property="ToolTip" Value="クリックしてからキー(修飾キー込み)を押してください" />
			<EventSetter Event="PreviewKeyDown"
						 Handler="KeyCapture_PreviewKeyDown" />
		</Style>
	</Window.Resources>

	<DockPanel Margin="10">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="190" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="220" />
				<ColumnDefinition Width="10" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  1列目: アプリ(プロファイル)  -->
			<DockPanel>
				<TextBlock Margin="0,0,0,4"
						   DockPanel.Dock="Top"
						   FontWeight="Bold"
						   Text="対象アプリ" />
				<UniformGrid Margin="0,6,0,0"
							 Columns="2"
							 DockPanel.Dock="Bottom">
					<Button Margin="0,0,3,0"
							Click="AddProfile_Click"
							Content="追加..." />
					<Button x:Name="RemoveProfileButton"
							Margin="3,0,0,0"
							Click="RemoveProfile_Click"
							Content="削除..." />
				</UniformGrid>
				<ListBox x:Name="ProfileList"
						 DisplayMemberPath="DisplayName"
						 SelectionChanged="ProfileList_SelectionChanged" />
			</DockPanel>

			<!--  2列目: ショートカット一覧  -->
			<DockPanel Grid.Column="2">
				<TextBlock Margin="0,0,0,4"
						   DockPanel.Dock="Top"
						   FontWeight="Bold"
						   Text="ショートカット" />
				<UniformGrid Margin="0,6,0,0"
							 Columns="2"
							 DockPanel.Dock="Bottom">
					<Button Margin="0,0,3,0"
							Click="AddShortcut_Click"
							Content="追加" />
					<Button Margin="3,0,0,0"
							Click="RemoveShortcut_Click"
							Content="削除..." />
				</UniformGrid>
				<ListBox x:Name="ShortcutList"
						 SelectionChanged="ShortcutList_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate DataType="{x:Type local:Shortcut}">
							<StackPanel Margin="0,2">
								<TextBlock FontWeight="SemiBold"
										   Text="{Binding Name}" />
								<TextBlock Foreground="Gray"
										   Text="{Binding Trigger.Text}" />
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>

			<!--  3列目: ショートカットの編集  -->
			<DockPanel x:Name="ShortcutEditor"
					   Grid.Column="4"
					   Margin="0,20,0,0">
				<Grid Margin="0,0,0,8"
					  DockPanel.Dock="Top">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition />
						<RowDefinition />
						<RowDefinition />
					</Grid.RowDefinitions>
					<TextBlock Margin="0,0,8,4"
							   VerticalAlignment="Center"
							   Text="名前" />
					<TextBox Grid.Column="1"
							 Margin="0,0,0,4"
							 Padding="3"
							 Text="{Binding Name,
											UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock Grid.Row="1"
							   Margin="0,0,8,4"
							   VerticalAlignment="Center"
							   Text="ショートカット" />
					<TextBox Grid.Row="1"
							 Grid.Column="1"
							 Margin="0,0,0,4"
							 DataContext="{Binding Trigger}"
							 Style="{StaticResource KeyCaptureBox}" />
					<CheckBox Grid.Row="2"
							  Grid.Column="1"
							  Content="有効"
							  IsChecked="{Binding Enabled}" />
				</Grid>

				<TextBlock Margin="0,0,0,4"
						   DockPanel.Dock="Top"
						   FontWeight="Bold"
						   Text="動作(上から順に実行)" />
				<StackPanel Margin="0,6,0,0"
							DockPanel.Dock="Bottom"
							Orientation="Horizontal">
					<Button Click="AddKeyStep_Click"
							Content="+ キー入力" />
					<Button Margin="6,0,0,0"
							Click="AddWaitStep_Click"
							Content="+ 待ち時間" />
				</StackPanel>

				<Border BorderBrush="#DDD"
						BorderThickness="1">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl x:Name="StepList"
									  Margin="4">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="{x:Type local:MacroStep}">
									<Grid Margin="0,2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="80" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock VerticalAlignment="Center"
												   Foreground="Gray"
												   Text="▶" />
										<TextBlock x:Name="KindLabel"
												   Grid.Column="1"
												   VerticalAlignment="Center"
												   Text="キー入力" />
										<TextBox x:Name="KeyBox"
												 Grid.Column="2"
												 DataContext="{Binding Key}"
												 Style="{StaticResource KeyCaptureBox}" />
										<StackPanel x:Name="WaitBox"
													Grid.Column="2"
													Orientation="Horizontal"
													Visibility="Collapsed">
											<TextBox Width="80"
													 Padding="3"
													 HorizontalContentAlignment="Right"
													 Text="{Binding Milliseconds,
																	UpdateSourceTrigger=PropertyChanged}" />
											<TextBlock VerticalAlignment="Center"
													   Text=" ミリ秒" />
										</StackPanel>
										<StackPanel Grid.Column="3"
													Margin="6,0,0,0"
													Orientation="Horizontal">
											<Button Padding="6,0"
													Click="MoveStepUp_Click"
													Content="↑"
													ToolTip="上へ" />
											<Button Margin="2,0"
													Padding="6,0"
													Click="MoveStepDown_Click"
													Content="↓"
													ToolTip="下へ" />
											<Button Padding="6,0"
													Click="RemoveStep_Click"
													Content="×"
													ToolTip="削除" />
										</StackPanel>
									</Grid>
									<DataTemplate.Triggers>
										<DataTrigger Binding="{Binding Kind}"
													 Value="Wait">
											<Setter TargetName="KindLabel" Property="Text" Value="待ち時間" />
											<Setter TargetName="KeyBox" Property="Visibility" Value="Collapsed" />
											<Setter TargetName="WaitBox" Property="Visibility" Value="Visible" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</DockPanel>
		</Grid>
	</DockPanel>
</Window>
