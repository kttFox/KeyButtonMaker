<Window x:Class="KeyButtonMaker.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリを選択" Width="520" Height="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="実行中のアプリから選ぶか、プロセス名を入力してください。" Margin="0,0,0,6" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Padding="4" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Padding="4" Margin="6,0,0,0" IsCancel="True" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="プロセス名" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ProcessBox" Padding="3" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="更新" Padding="8,2" Click="Refresh_Click" />
            <TextBlock Text="実行中のアプリ" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <ListView x:Name="ProcessList" SelectionChanged="ProcessList_SelectionChanged"
                  MouseDoubleClick="ProcessList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="プロセス名" Width="150" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="ウィンドウタイトル" Width="300" DisplayMemberBinding="{Binding Title}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
